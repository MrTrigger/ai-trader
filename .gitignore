# Market data and plans are derived artifacts, reproducible from the source
# plus a manifest. The store is not the asset; the code that fills it is.
/data/
/training/.venv/
/training/**/__pycache__/
/training/.pytest_cache/
/training/*.egg-info/
/service/target/

# Operational state: controls, run history, the order ledger, the paper venue's
# books. Live and machine-local by definition - the code that produces it is the
# asset, and committing a snapshot of a running account would be a mistake in
# both directions.
/var/

.env
*.log

# The rendered research view is derived from the committed record.
docs/research/*.html
data/models/
.claude/worktrees/
