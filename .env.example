# ai-trader — credentials and account identity
#
# Copy to `.env` and fill in. `.env` is gitignored; this example is not, so
# never put a real key or address in this file.
#
#   cp .env.example .env && $EDITOR .env
#
# Nothing here is needed to run against the paper venue on live prices — the
# read path below is public. Only the live trading key is privileged, and it is
# the one thing in this file that can lose money.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Reading the market — no credentials required
# ─────────────────────────────────────────────────────────────────────────────
# Hyperliquid's info API is public: mids, marks, candles, order books, and
# anyone's positions and fills. This is all the paper venue needs to trade
# against real prices.

HL_API_URL=https://api.hyperliquid.xyz
# Testnet, for everything before real capital:
# HL_API_URL=https://api.hyperliquid-testnet.xyz


# ─────────────────────────────────────────────────────────────────────────────
# 2. Your account — needed to READ your own balances, positions and fills
# ─────────────────────────────────────────────────────────────────────────────
# The wallet that holds the funds on Hyperliquid. This is a public address, not
# a secret; it is what every `user` query is asked about. Reconciliation needs
# it even in paper mode if you want to compare against a real account.
#
#   Find it: Hyperliquid UI, top right, your connected wallet address.

HL_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000

# Only if you trade a vault rather than your own account. Leave blank otherwise.
HL_VAULT_ADDRESS=


# ─────────────────────────────────────────────────────────────────────────────
# 3. Trading — the only privileged secret here
# ─────────────────────────────────────────────────────────────────────────────
# Use an AGENT WALLET (Hyperliquid calls it an API wallet), never your main
# wallet's key. An agent can place and cancel orders and it CANNOT withdraw,
# which is exactly the boundary design spec §3.3 requires: the process that
# trades must not be able to move funds off the venue.
#
#   Create one: Hyperliquid UI → More → API → Generate. It gives you a private
#   key once. That key authorises trading on HL_ACCOUNT_ADDRESS's behalf.
#
# Leave this blank to run read-only. The bot refuses to start in live mode
# without it rather than discovering it missing at the first order.
#
# Agent wallets expire — Hyperliquid ages them out. If live orders start being
# rejected as unauthorised, generate a new one.

HL_AGENT_PRIVATE_KEY=


# The API wallet's own name and address, as Hyperliquid showed them when you
# generated it. Neither is a secret and neither is strictly required — the
# address is derivable from the key.
#
# They are here because the derived address is checked against the declared one
# at startup. A key that pastes wrong still parses, still signs, and produces
# signatures the venue silently disbelieves; the rejection does not say which
# agent it disbelieved. Declaring the address turns that into an error before
# anything is sent.
#
# The name is what you called the agent in the UI. Hyperliquid ages agents out,
# and "which of these three is the bot using" is otherwise unanswerable.
HL_AGENT_NAME=
HL_AGENT_ADDRESS=

# Belt and braces. Live mode ALSO requires this to be exactly "yes", so that a
# copied config or a stray --venue flag cannot start trading real money on its
# own. Both this and a key must be present.
HL_ALLOW_LIVE=no


# ─────────────────────────────────────────────────────────────────────────────
# 4. Market data for the planner
# ─────────────────────────────────────────────────────────────────────────────
# The planner's history comes from Binance's public archive and REST API, both
# unauthenticated. Nothing to fill in — recorded here so the dependency is
# visible rather than buried in the source.
#
# Note the mismatch worth deciding about deliberately: the research ranked on
# Binance bars while the strategy trades Hyperliquid perps. Fine as a proxy for
# backtesting, a basis difference when live.

BINANCE_API_URL=https://api.binance.com
BINANCE_ARCHIVE_URL=https://data.binance.vision


# ─────────────────────────────────────────────────────────────────────────────
# 5. Where state lives
# ─────────────────────────────────────────────────────────────────────────────
# Controls, run history, the order ledger and the paper venue's books. Under
# var/ by default, which is gitignored and survives a reboot.

AI_TRADER_STATE_DIR=var/live/state
AI_TRADER_BOT_CONFIG=var/live/bot.json

# ─────────────────────────────────────────────────────────────────────────────
# 6. The identity registry
# ─────────────────────────────────────────────────────────────────────────────
# Who is allowed to trade, and as whom. The Fleet view reads it, and every bot
# checks itself against it at startup: with this set, an unregistered or
# disabled bot refuses to run rather than trading unannounced. Unset, the bot
# runs file-only in dev mode and says so loudly.
#
# Local dev database — `docker compose up -d` brings it up on 5433. Production
# is the triggerlab cluster's Postgres; the compose file exists so local runs
# and CI get the same schema.
#
# Not a secret worth guarding here: it is a loopback-only container with
# throwaway credentials. A real one belongs in SOPS like any other.

DATABASE_URL=postgres://aitrader:aitrader@127.0.0.1:5433/ai_trader


# ─────────────────────────────────────────────────────────────────────────────
# 7. The futures bot — IB Gateway (bot_id: futures-noise)
# ─────────────────────────────────────────────────────────────────────────────
# Interactive Brokers authentication happens IN the Gateway application. The
# login values below are for a Gateway/IBC launcher; the bot itself only needs
# the endpoint, expected account, and arming flags and never sends a username
# or password over the IB API connection.
#
# The accounts registry references these by credential_ref: 'IB_PAPER' and
# 'IB_LIVE' resolve to the variable groups below.
#
# WSL note: the Gateway runs on Windows; mirrored networking must be on for
# 127.0.0.1 to reach it. `bots/futures/run.sh shadow` (or the journal repo's
# `ib-check`) verifies connectivity, account and market-data streaming.

# The Gateway endpoint is independent of which account is logged in. A local
# Gateway normally exposes 4002 for paper or 4001 for live; the cluster relay
# exposes 4004. Point this at the Gateway instance this process should use.
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PORT=4002

# Login credentials are consumed by the Gateway/IBC process, never sent over
# the IB API connection by a bot. Keep both sets available so the Gateway
# launcher can select one explicitly; do not infer a mode from the port.
IB_PAPER_USERNAME=
IB_PAPER_PASSWORD=
# Your paper account id — starts with DU. The bot verifies the connected
# account matches before doing anything; a mismatch is a refusal, not a shrug.
IB_PAPER_ACCOUNT=DU0000000

# Live identity. Leave the account blank until the paper stage has passed its
# gates. Live order flow also requires both arming flags below.
IB_LIVE_USERNAME=
IB_LIVE_PASSWORD=
IB_LIVE_ACCOUNT=

# The two-flag arming (mirrors HL_ALLOW_LIVE's belt-and-braces): orders are
# refused unless IB_ALLOW_ORDERS=yes AND the connected account is a paper
# account — a LIVE account additionally requires IB_ALLOW_LIVE=yes. Shadow
# mode ignores both: it never places orders anywhere.
IB_ALLOW_ORDERS=no
IB_ALLOW_LIVE=no

# --- 8. AMP Futures — reached over the Rithmic gateway ----------------------
# AMP is the broker (the FCM holding the account and clearing the trades);
# Rithmic is the connectivity gateway it is reached through, and these are
# Rithmic's own variable names because its client library defines them.
# AMP issues the credentials when the account opens.
# Secrets live HERE (env/SOPS), never in the DB — the registry stores only
# the references RITHMIC_DEMO / RITHMIC_LIVE.
RITHMIC_APP_NAME=
RITHMIC_APP_VERSION=1.0
# Demo (paper) environment:
RITHMIC_DEMO_USER=
RITHMIC_DEMO_PW=
RITHMIC_DEMO_URL=
RITHMIC_DEMO_ALT_URL=
RITHMIC_DEMO_ACCOUNT_ID=
RITHMIC_DEMO_FCM_ID=
RITHMIC_DEMO_IB_ID=
# Live environment (leave empty until AMP is funded):
RITHMIC_LIVE_USER=
RITHMIC_LIVE_PW=
RITHMIC_LIVE_URL=
RITHMIC_LIVE_ALT_URL=
RITHMIC_LIVE_ACCOUNT_ID=
RITHMIC_LIVE_FCM_ID=
RITHMIC_LIVE_IB_ID=
# Instrument + arming (same two-flag posture as IB):
RITHMIC_SYMBOL=MNQ
RITHMIC_EXCHANGE=CME
RITHMIC_MULTIPLIER=2
RITHMIC_TICK=0.25
RITHMIC_ALLOW_ORDERS=no
RITHMIC_ALLOW_LIVE=no
